{
  "name": "beachsafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file .env.local scripts/migrate.ts",
    "etl": "tsx --env-file .env.local scripts/etl/run-all.ts",
    "etl:no-weather": "tsx --env-file .env.local scripts/etl/run-all.ts --skip-weather",
    "etl:ingest-only": "tsx --env-file .env.local scripts/etl/run-all.ts --skip-enrich",
    "etl:fingerprints": "tsx --env-file .env.local scripts/etl/run-all.ts --skip-all-ingest",
    "migrate:ci": "tsx scripts/migrate.ts",
    "seed:ci": "tsx scripts/etl/run-all.ts --skip-weather --skip-waves --skip-tides --skip-rnli --skip-enrich",
    "etl:climatology": "tsx --env-file .env.local scripts/etl/build-climatology.ts",
    "etl:probe-waves": "tsx --env-file .env.local scripts/etl/probe-wave-points.ts",
    "analysis:discrimination": "tsx --env-file .env.local scripts/analysis/discrimination.ts",
    "analysis:tier-frequency": "tsx --env-file .env.local scripts/analysis/tier-frequency.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@neondatabase/serverless": "^1.1.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "suncalc": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
